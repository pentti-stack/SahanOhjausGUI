<Window x:Class="SahanOhjausGUI.WinCCIntegrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinCC-integraatio" Height="680" Width="900"
        Background="#12100c"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="12,6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2a2a2a"/>
                    <Setter Property="Foreground" Value="#4fc3f7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#12100c"/>
            <Setter Property="BorderBrush" Value="#333"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1a1a1a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333"/>
            <Setter Property="AlternatingRowBackground" Value="#1e1e1e"/>
            <Setter Property="RowBackground" Value="#161616"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Foreground" Value="#4fc3f7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2a4a6a"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2a4a6a"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1a1a1a"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Otsikkorivi -->
        <Border Grid.Row="0" Background="#0d0b09" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙ WinCC-integraatio" FontSize="16" FontWeight="Bold"
                               Foreground="#4fc3f7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SimulaatioMerkki" Text="  🔴 SIMULAATIOTILA"
                               FontSize="13" FontWeight="Bold" Foreground="#ff4444"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border x:Name="YhteysStatusBorder" CornerRadius="4" Padding="8,4" Margin="0,0,12,0"
                            Background="#1a1a1a" BorderBrush="#444" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="YhteysLamppu" Width="10" Height="10"
                                     Fill="#ff4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="YhteysStatusTeksti" Text="Ei yhteyttä"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ValmisIndikaattori" CornerRadius="4" Padding="8,4"
                            Background="#1a1a1a" BorderBrush="#444" BorderThickness="1">
                        <TextBlock x:Name="ValmistusTeksti" Text="⏳ ODOTTAA"
                                   FontSize="12" FontWeight="Bold" Foreground="#888"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Välilehdet -->
        <TabControl Grid.Row="1" Margin="8">

            <!-- ── VÄLILEHTI 1: Yhteys & Lähetys ── -->
            <TabItem Header="🔌 Yhteys &amp; Lähetys">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <!-- Yhteys -->
                        <GroupBox Header="Yhteyden hallinta">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Palvelin:" Width="100" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="YhteysServerNimi" Text="—"
                                                   Foreground="#4fc3f7" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Tagi-etuliite:" Width="100" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="YhteysPrefixNimi" Text="—"
                                                   Foreground="#4fc3f7" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Versio:" Width="100" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="YhteysVersionTeksti" Text="—"
                                                   Foreground="#4fc3f7" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button x:Name="YhdistaNappi" Content="▶ Yhdistä"
                                            Width="130" Height="36" Margin="0,0,0,6"
                                            Background="#1b5e20" BorderBrush="#388e3c"
                                            Click="YhdistaNappi_Click"/>
                                    <Button x:Name="KatkaisNappi" Content="■ Katkaise"
                                            Width="130" Height="36"
                                            Background="#5e1b1b" BorderBrush="#8e3838"
                                            IsEnabled="False"
                                            Click="KatkaisNappi_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- VALMIS SYÖTTEESEEN -->
                        <Border x:Name="ValmisIsoIndikaattori" CornerRadius="8" Padding="16,12"
                                Background="#1a1a1a" BorderBrush="#333" BorderThickness="1"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="ValmisIsoTeksti" Text="⏳ ODOTTAA — akselit eivät paikassaan"
                                               FontSize="15" FontWeight="Bold" Foreground="#888"/>
                                    <TextBlock x:Name="ToleranceTeksti" Text="Toleranssi: ±0.2 mm | Akselit paikassaan: 0 / 18"
                                               FontSize="11" Foreground="#666" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1" x:Name="ValmisLamppu"
                                         Width="24" Height="24" Fill="#444"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Lähetys -->
                        <GroupBox Header="Kuvion lähetys">
                            <StackPanel>
                                <TextBlock Text="Seuraavat SetPoint-arvot lähetetään WinCC-tageihin nappia painamalla:"
                                           Foreground="#aaa" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <Button x:Name="LahetaKuvioNappi"
                                        Content="⚡ Lähetä kuvio koneelle"
                                        Height="44" FontSize="14" FontWeight="Bold"
                                        Background="#1a3a5c" BorderBrush="#2a6aac"
                                        Click="LahetaKuvioNappi_Click"/>
                                <TextBlock x:Name="LahetysStatusTeksti" Text=""
                                           FontSize="12" Margin="0,8,0,0"
                                           Foreground="#aaa" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- SetPoint-yhteenveto -->
                        <GroupBox Header="Nykyiset SetPoint-arvot (laskettu kuviosta)">
                            <Grid x:Name="SetPointYhteenvetoGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Jakosaha" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,4"/>
                                    <ItemsControl x:Name="JakosahaSPList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <TextBlock Text="{Binding Name}" Width="80" Foreground="#aaa" FontSize="11"/>
                                                    <TextBlock Text="{Binding ValueStr}" Foreground="White" FontSize="11"/>
                                                    <TextBlock Text=" mm" Foreground="#666" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Pintahakkurit" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,4"/>
                                    <ItemsControl x:Name="PintahakkuriSPList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <TextBlock Text="{Binding Name}" Width="100" Foreground="#aaa" FontSize="11"/>
                                                    <TextBlock Text="{Binding ValueStr}" Foreground="White" FontSize="11"/>
                                                    <TextBlock Text=" mm" Foreground="#666" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Profilointi" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,4"/>
                                    <ItemsControl x:Name="ProfilointiSPList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <TextBlock Text="{Binding Name}" Width="80" Foreground="#aaa" FontSize="11"/>
                                                    <TextBlock Text="{Binding ValueStr}" Foreground="White" FontSize="11"/>
                                                    <TextBlock Text=" mm" Foreground="#666" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── VÄLILEHTI 2: Reaaliaikainen tila ── -->
            <TabItem Header="📊 Reaaliaikainen tila">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Päivitys: " Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="PaivitysaikaTeksti" Text="—" Foreground="#4fc3f7" FontSize="11"/>
                        <TextBlock Text="  |  Heartbeat: " Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="HeartbeatTeksti" Text="—" Foreground="#4fc3f7" FontSize="11"/>
                    </StackPanel>
                    <DataGrid x:Name="AkseliTaulukko" Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Akseli" Binding="{Binding AkseliNimi}" Width="130"/>
                            <DataGridTextColumn Header="SetPoint (mm)" Binding="{Binding SetPoint}" Width="110"/>
                            <DataGridTextColumn Header="Actual (mm)" Binding="{Binding Actual}" Width="110"/>
                            <DataGridTextColumn Header="Erotus (mm)" Binding="{Binding Erotus}" Width="100"/>
                            <DataGridTemplateColumn Header="Tila" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tila}"
                                                   Foreground="{Binding TilaVari}"
                                                   FontWeight="Bold" Padding="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ── VÄLILEHTI 3: Hälytykset ── -->
            <TabItem Header="🚨 Hälytykset">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Alarm_Word: " Foreground="#888"/>
                        <TextBlock x:Name="AlarmWordHex" Text="0x0000" Foreground="#4fc3f7" FontFamily="Consolas" FontSize="14"/>
                        <TextBlock Text="  (desim: " Foreground="#888"/>
                        <TextBlock x:Name="AlarmWordDec" Text="0" Foreground="#4fc3f7" FontFamily="Consolas" FontSize="14"/>
                        <TextBlock Text=")" Foreground="#888"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#1a1a1a" BorderBrush="#333" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer>
                            <ItemsControl x:Name="HalytysLista" Margin="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="8,6" CornerRadius="3"
                                                Background="{Binding Tausta}" BorderBrush="{Binding Reuna}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Bitti}" Width="60"
                                                           Foreground="#888" FontFamily="Consolas" FontSize="12"/>
                                                <TextBlock Text="{Binding Teksti}"
                                                           Foreground="{Binding Vari}" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── VÄLILEHTI 4: Asetukset ── -->
            <TabItem Header="⚙ Asetukset">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <!-- WinCC-palvelin -->
                        <GroupBox Header="WinCC-palvelin">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Palvelimen nimi:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBox x:Name="ServerNimiTextBox" Grid.Column="1"
                                         Margin="0,0,0,8" Height="28"
                                         ToolTip="Esim. localhost tai \\\\PALVELIN\\WinCC"/>
                                <TextBlock Grid.Row="1" Text="Tag-etuliite:" VerticalAlignment="Center"/>
                                <TextBox x:Name="TagPrefixTextBox" Grid.Row="1" Grid.Column="1"
                                         Height="28"
                                         ToolTip="Esim. Saha1_ tai Saha2_"/>
                            </Grid>
                        </GroupBox>

                        <!-- WinCC-versio -->
                        <GroupBox Header="WinCC-versio">
                            <StackPanel>
                                <RadioButton x:Name="VersionARadio"
                                             Content="Vaihtoehto A — WinCC V7/V8 (COM/OLE: HMIRuntime.Tags)"
                                             IsChecked="True"/>
                                <RadioButton x:Name="VersionBRadio"
                                             Content="Vaihtoehto B — WinCC Unified (OPC UA / Named Pipe JSON)"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Simulaattori -->
                        <GroupBox Header="Simulaatiotila">
                            <StackPanel>
                                <CheckBox x:Name="SimulaattoriCheckBox"
                                          Content="Käytä simulaattoria (ohittaa WinCC-rajapinnan)"
                                          Margin="0,0,0,6"/>
                                <TextBlock Text="Simulaattori liukuttaa Actual-arvoja kohti SetPoint-arvoja nopeudella 10 mm/s."
                                           Foreground="#aaa" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Hälytysten tekstit -->
                        <GroupBox Header="Hälytystekstit (bitit 0–15)">
                            <Grid x:Name="HalytysTekstitGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="HalytysTekstitVasen" Grid.Column="0"/>
                                <StackPanel x:Name="HalytysTekstitOikea" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>

                        <!-- Tallenna/lataa -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="💾 Tallenna asetukset" Width="150" Height="32"
                                    Margin="0,0,8,0"
                                    Background="#1b5e20" BorderBrush="#388e3c"
                                    Click="TallennaAsetukset_Click"/>
                            <Button Content="↺ Palauta oletukset" Width="150" Height="32"
                                    Background="#4a3500" BorderBrush="#7a5500"
                                    Click="PalautaOletukset_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
