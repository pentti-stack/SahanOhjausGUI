<Window x:Class="SahanOhjausGUI.WinCCIntegrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinCC-integraatio" Height="700" Width="960"
        Background="#120F0C"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2420"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3d3d3d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1E1A17"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#120F0C"/>
                    <Setter Property="Foreground" Value="#4fc3f7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A2420"/>
            <Setter Property="Foreground" Value="#4fc3f7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2420"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1b3a5e"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E1A17"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#251F1B"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1b3a5e"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Yläpalkki -->
        <Border Grid.Row="0" Background="#0D0A08">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WinCC-integraatio" FontSize="15" FontWeight="Bold" Foreground="#4fc3f7"/>
                    <TextBlock x:Name="SimulationBadge"
                               Text="  ⚠ SIMULAATIOTILA"
                               FontSize="13" FontWeight="Bold" Foreground="#FF4444"
                               Visibility="Collapsed" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionDot" Width="12" Height="12"
                             Fill="#555" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="ConnectionStatusText" Text="Yhdistämätön"
                               VerticalAlignment="Center" FontSize="12" Foreground="#aaa"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Välilehdet -->
        <TabControl Grid.Row="1" Background="#120F0C" BorderBrush="#333"
                    AlternationCount="2">

            <!-- ══════════════════════════════════════════════════
                 Välilehti 1: Yhteys & Lähetys
                 ══════════════════════════════════════════════════ -->
            <TabItem Header="🔌 Yhteys &amp; Lähetys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#120F0C">
                    <StackPanel Margin="16" MaxWidth="640">

                        <!-- Yhteyskortti -->
                        <Border Background="#1E1A17" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Yhteys WinCC-järjestelmään"
                                           FontSize="14" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="ConnectBtn" Content="Yhdistä"
                                            Click="ConnectBtn_Click" Width="110" Height="32"
                                            Background="#1b5e20" BorderBrush="#388e3c" Margin="0,0,8,0"/>
                                    <Button x:Name="DisconnectBtn" Content="Katkaise yhteys"
                                            Click="DisconnectBtn_Click" Width="130" Height="32"
                                            Background="#6d1010" BorderBrush="#8b1a1a" IsEnabled="False"/>
                                </StackPanel>
                                <Border Background="#2A2420" CornerRadius="6" Padding="12,8">
                                    <TextBlock x:Name="ConnectionDetailText"
                                               Text="Ei yhteyttä WinCC-järjestelmään. Tarkista asetukset ja paina Yhdistä."
                                               TextWrapping="Wrap" Foreground="#aaa" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Kuvion lähetyskortti -->
                        <Border Background="#1E1A17" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Kuvion lähetys koneelle"
                                           FontSize="14" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#aaa" FontSize="12" Margin="0,0,0,10">
                                    Painamalla nappia kirjoitetaan kaikki 18 SetPoint-tagia WinCC:hen,
                                    minkä jälkeen nostetaan hetkellisesti {Prefix}New_Data_Ready -bitti
                                    (1 → odota 500 ms → 0).
                                </TextBlock>
                                <Button x:Name="LahetaKuvioBtn"
                                        Content="⚡  Lähetä kuvio koneelle"
                                        Click="LahetaKuvio_Click"
                                        Height="40" FontSize="14" FontWeight="Bold"
                                        Background="#0d47a1" BorderBrush="#1565c0"
                                        IsEnabled="False"/>
                                <TextBlock x:Name="LahetaStatusText" Text=""
                                           Margin="0,8,0,0" FontSize="11" Foreground="#aaa"/>
                            </StackPanel>
                        </Border>

                        <!-- Valmis-indikaattori -->
                        <Border Background="#1E1A17" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Asemointistatus"
                                           FontSize="14" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,10"/>
                                <Border x:Name="ValmisIndicator" CornerRadius="8" Padding="16,14">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="ValmisBackground" Color="#2A2420"/>
                                    </Border.Background>
                                    <TextBlock x:Name="ValmisText"
                                               Text="⚫  ODOTTAA TIETOJA"
                                               FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="#555"/>
                                </Border>
                                <TextBlock x:Name="ValmisDetailText" Text=""
                                           Margin="0,8,0,0" FontSize="11" Foreground="#aaa"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════════════════
                 Välilehti 2: Reaaliaikainen tila
                 ══════════════════════════════════════════════════ -->
            <TabItem Header="📊 Reaaliaikainen tila">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Infopalkki -->
                    <Border Grid.Row="0" Background="#1E1A17" Padding="10,6" BorderBrush="#333" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Päivityssykli: " Foreground="#aaa" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock x:Name="PollRateText" Text="150 ms"
                                       Foreground="#4fc3f7" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="12"/>
                            <TextBlock x:Name="LastUpdateText" Text="Viimeisin päivitys: —"
                                       Foreground="#aaa" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Akseli-taulukko -->
                    <DataGrid x:Name="AxisGrid" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              AlternationCount="2"
                              Background="#1E1A17"
                              RowBackground="#1E1A17"
                              AlternatingRowBackground="#251F1B"
                              HorizontalGridLinesBrush="#2A2420"
                              VerticalGridLinesBrush="#2A2420"
                              BorderBrush="#333"
                              ColumnHeaderHeight="34"
                              RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ryhmä" Binding="{Binding Group}"
                                                Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Akseli" Binding="{Binding Name}"
                                                Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="SetPoint (mm)"
                                                Binding="{Binding SetPoint, StringFormat=F2, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Actual (mm)"
                                                Binding="{Binding Actual, StringFormat=F2}"
                                                Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Erotus (mm)"
                                                Binding="{Binding Difference, StringFormat=F2}"
                                                Width="100" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Status" Width="80" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="Bold" Padding="6,3"
                                                   Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#f44336"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                            <Setter Property="Foreground" Value="#4caf50"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════════════
                 Välilehti 3: Hälytykset
                 ══════════════════════════════════════════════════ -->
            <TabItem Header="🚨 Hälytykset">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Alarm_Word näyttö -->
                    <Border Grid.Row="0" Background="#1E1A17" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Alarm_Word:" Foreground="#aaa" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="AlarmWordText" Text="0x0000"
                                       FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                                       Foreground="#FF6B6B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AlarmWordDecText" Text="  (0)"
                                       FontFamily="Consolas" FontSize="13"
                                       Foreground="#aaa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Aktiiviset hälytykset -->
                    <Border Grid.Row="1" Background="#1E1A17" CornerRadius="8" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AlarmListPanel">
                                <TextBlock Text="Ei aktiivisia hälytyksiä"
                                           Foreground="#4caf50" FontSize="13" Margin="0,4"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════════════
                 Välilehti 4: Asetukset
                 ══════════════════════════════════════════════════ -->
            <TabItem Header="⚙ Asetukset">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#120F0C">
                    <StackPanel Margin="16" MaxWidth="640">

                        <!-- Palvelinkortti -->
                        <Border Background="#1E1A17" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="WinCC-palvelin"
                                           FontSize="14" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,10"/>
                                <TextBlock Text="Palvelimen nimi tai verkkopolku:"
                                           Foreground="#aaa" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="ServerNameBox" Height="28" Margin="0,0,0,10"/>
                                <TextBlock Text="Tag-etuliite (Prefix):"
                                           Foreground="#aaa" FontSize="12" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TagPrefixBox" Width="160" Height="28"/>
                                    <TextBlock Foreground="#aaa" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Text="esim. Saha1_  →  Saha1_Jakosaha_T1_SetPoint"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- WinCC-versiokortti -->
                        <Border Background="#1E1A17" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="WinCC-versio"
                                           FontSize="14" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,10"/>
                                <RadioButton x:Name="VersionV7Radio"
                                             Content="Vaihtoehto A — WinCC V7/V8  (COM/OLE: HMIRuntime.Tags[].Write/Read)"
                                             GroupName="WinCCVersion" Margin="0,0,0,8"/>
                                <RadioButton x:Name="VersionUnifiedRadio"
                                             Content="Vaihtoehto B — WinCC Unified  (OPC UA / Named Pipe JSON)"
                                             GroupName="WinCCVersion"/>
                            </StackPanel>
                        </Border>

                        <!-- Simulaattorikortti -->
                        <Border Background="#1E1A17" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Simulaattori"
                                           FontSize="14" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SimulatorCheck"
                                          Content="Käytä simulaattoria (ohittaa WinCC-rajapinnan)"
                                          Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#aaa" FontSize="11">
                                    Simulaattoritilassa Actual-arvot liukuvat kohti SetPoint-arvoja
                                    nopeudella 10 mm/s. Tila merkitään selkeästi otsikkopalkissa.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Automaattinen lähetys -->
                        <Border Background="#1E1A17" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Automaattinen lähetys"
                                           FontSize="14" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,10"/>
                                <CheckBox x:Name="AutoLahetysCheck"
                                          Content="Automaattinen lähetys WinCC:hen"
                                          Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#aaa" FontSize="11">
                                    Kun päällä: SetPoint-arvot lähetetään WinCC-tageihin automaattisesti
                                    aina kun MainWindow laskee uudet arvot (PiirraVisual kutsuu PaivitaSetPoints).
                                    Kun pois: Arvot päivittyvät näytölle mutta lähetetään vasta
                                    "Lähetä kuvio koneelle" -napista.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Hälytysbittien tekstit -->
                        <Border Background="#1E1A17" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Hälytysbittien tekstit (Alarm_Word, bitit 0–15)"
                                           FontSize="14" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,6"/>
                                <TextBlock Foreground="#aaa" FontSize="11" Margin="0,0,0,10"
                                           Text="Muokkaa tekstikenttiin haluamasi nimet. Tallenna asetukset -nappi tallentaa muutokset."/>
                                <ItemsControl x:Name="AlarmBitItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           Foreground="#aaa" FontFamily="Consolas"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="Consolas" FontSize="11"
                                                         Height="22" Padding="4,2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Tallenna / Lataa -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="💾 Tallenna asetukset"
                                    Click="TallennaAsetukset_Click"
                                    Background="#1b5e20" BorderBrush="#388e3c"
                                    Height="32" Margin="0,0,8,0"/>
                            <Button Content="📂 Lataa asetukset"
                                    Click="LataaAsetukset_Click"
                                    Height="32"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
