<Window x:Class="SahanOhjausGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sahan ohjaus" Height="600" Width="1400"
        Background="#1a1a1a">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Background="#2d2d2d" BorderBrush="#555"
                                          Foreground="White"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Padding="6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        VerticalAlignment="Center" Margin="4,0"/>
                                    <TextBlock Grid.Column="1" Text="&#x25BE;"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="White"/>
                                </Grid>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True">
                                <Border Background="#2d2d2d" BorderBrush="#555"
                                        BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#4fc3f7"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3d3d3d"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3d3d3d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1a1a1a"/>
                    <Setter Property="Foreground" Value="#4fc3f7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Yläpalkki -->
        <Grid Grid.Row="0" Background="#111">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="Sahan ohjaus" FontSize="14" FontWeight="Bold"
                           Foreground="#4fc3f7" Margin="0,0,16,0"/>
                <TextBlock x:Name="StatusTextBlock" Text="Valmis" FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock x:Name="Ph1V_Value" Text="PH1V: -" Margin="0,0,8,0" Foreground="#FFC850"/>
                <TextBlock x:Name="Ph1O_Value" Text="PH1O: -" Margin="0,0,8,0" Foreground="#FFC850"/>
                <TextBlock x:Name="Ph2V_Value" Text="PH2V: -" Margin="0,0,8,0" Foreground="#50C8FF"/>
                <TextBlock x:Name="Ph2O_Value" Text="PH2O: -" Margin="0,0,16,0" Foreground="#50C8FF"/>
                <TextBlock Text="|" Foreground="#555" Margin="0,0,16,0"/>
                <TextBlock x:Name="Prof_Value" Text="Prof: -" Margin="0,0,16,0" Foreground="#B39DDB"/>
                <TextBlock Text="|" Foreground="#555" Margin="0,0,16,0"/>
                <TextBlock Text="V:" Foreground="#aaa" Margin="0,0,4,0"/>
                <TextBlock x:Name="Tera5_Value" Text="T5: -" Margin="0,0,8,0" Foreground="#FF6B6B"/>
                <TextBlock x:Name="Tera3_Value" Text="T3: -" Margin="0,0,8,0" Foreground="#FF6B6B"/>
                <TextBlock x:Name="Tera1_Value" Text="T1: -" Margin="0,0,16,0" Foreground="#FF6B6B"/>
                <TextBlock Text="O:" Foreground="#aaa" Margin="0,0,4,0"/>
                <TextBlock x:Name="Tera2_Value" Text="T2: -" Margin="0,0,8,0" Foreground="#6BCB77"/>
                <TextBlock x:Name="Tera4_Value" Text="T4: -" Margin="0,0,8,0" Foreground="#6BCB77"/>
                <TextBlock x:Name="Tera6_Value" Text="T6: -" Foreground="#6BCB77"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <CheckBox x:Name="KokoRuutuCheck" Content="Kokoruutu" Margin="0,0,12,0"
                          IsChecked="True"
                          Checked="KokoRuutuTila_Changed"
                          Unchecked="KokoRuutuTila_Changed"/>
                <Button x:Name="LahetaBtn" Content="&#x26A1; L&#xe4;het&#xe4; logiikkaan"
                        Click="Laheta_Click" Margin="0,0,8,0"
                        Background="#1b5e20" BorderBrush="#388e3c"/>
                <Button Content="&#x26A1; Ter&#xe4;asetukset" Click="AvaaTerapAsetukset_Click" Margin="0,0,8,0"/>
                <Button Content="&#x1F512; Terien rajat" Click="AvaaRajatAsetukset_Click" Margin="0,0,8,0"/>
                <Button Content="&#x1F4E1; PLC" Click="AvaaWinCCIntegration_Click"
                        Background="#1a237e" BorderBrush="#283593"/>
            </StackPanel>
        </Grid>

        <!-- Välilehdet -->
        <TabControl Grid.Row="1" Background="#1a1a1a" BorderBrush="#333"
                    SelectionChanged="TabControl_SelectionChanged">

            <!-- PELKKAHAKKURIT -->
            <TabItem Header="&#x1FAB5; Pelkkahakkurit">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#1e1e1e">
                        <StackPanel Margin="10">

                            <!-- PH1 -->
                            <Border Background="#2d2d2d" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="&#x1FAB5; PH1 &#x2014; Pelkkahakkuri 1"
                                               FontWeight="Bold" Foreground="#FFC850" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="Ph1Check" Content="K&#xe4;yt&#xf6;ss&#xe4;"
                                              IsChecked="True" Margin="0,0,0,6"
                                              Checked="PhValinta_Changed"
                                              Unchecked="PhValinta_Changed"/>
                                    <TextBlock Text="PH1 leveys:" FontSize="11" Foreground="#aaa" Margin="0,0,0,2"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBox x:Name="PhLevinKappaleBox" Width="80" Height="28"
                                                 Text="200" TextChanged="Ph_Changed"
                                                 Background="#3d3d3d" Foreground="White"
                                                 BorderBrush="#555" Padding="6,0"
                                                 VerticalContentAlignment="Center"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#aaa"/>
                                    </StackPanel>
                                    <TextBlock x:Name="Ph1LukittuLabel"
                                               Text="&#x1F512; lukittu — dimensiot jakosahalta"
                                               FontSize="10" Foreground="#888"
                                               Visibility="Collapsed" Margin="0,2,0,4"/>
                                    <!-- PH1 offset -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Offset:" FontSize="11" Foreground="#aaa"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Content="−" Width="26" Height="26"
                                                Click="Ph1OffsetMinus_Click" FontSize="14"
                                                Background="#3d3d3d" Foreground="White" BorderBrush="#555"/>
                                        <TextBlock x:Name="Ph1OffsetLabel" Text="0,0 mm"
                                                   Width="52" TextAlignment="Center"
                                                   VerticalAlignment="Center" FontSize="11"/>
                                        <Button Content="+" Width="26" Height="26"
                                                Click="Ph1OffsetPlus_Click" FontSize="14"
                                                Background="#3d3d3d" Foreground="White" BorderBrush="#555"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- PH2 -->
                            <Border Background="#2d2d2d" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="&#x1FAB5; PH2 &#x2014; Pelkkahakkuri 2"
                                               FontWeight="Bold" Foreground="#50C8FF" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="Ph2Check" Content="K&#xe4;yt&#xf6;ss&#xe4;"
                                              IsChecked="True" Margin="0,0,0,6"
                                              Checked="PhValinta_Changed"
                                              Unchecked="PhValinta_Changed"/>
                                    <TextBlock Text="PH2 leveys:" FontSize="11" Foreground="#aaa" Margin="0,0,0,2"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBox x:Name="PhKokonaisLeveysBox" Width="80" Height="28"
                                                 Text="200" TextChanged="Ph_Changed"
                                                 Background="#3d3d3d" Foreground="White"
                                                 BorderBrush="#555" Padding="6,0"
                                                 VerticalContentAlignment="Center"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#aaa"/>
                                    </StackPanel>
                                    <TextBlock x:Name="Ph2LukittuLabel"
                                               Text="&#x1F512; lukittu — dimensiot jakosahalta"
                                               FontSize="10" Foreground="#888"
                                               Visibility="Collapsed" Margin="0,2,0,4"/>
                                    <!-- PH2 offset -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Offset:" FontSize="11" Foreground="#aaa"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Content="−" Width="26" Height="26"
                                                Click="Ph2OffsetMinus_Click" FontSize="14"
                                                Background="#3d3d3d" Foreground="White" BorderBrush="#555"/>
                                        <TextBlock x:Name="Ph2OffsetLabel" Text="0,0 mm"
                                                   Width="52" TextAlignment="Center"
                                                   VerticalAlignment="Center" FontSize="11"/>
                                        <Button Content="+" Width="26" Height="26"
                                                Click="Ph2OffsetPlus_Click" FontSize="14"
                                                Background="#3d3d3d" Foreground="White" BorderBrush="#555"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Kuivaus PH -->
                            <Border Background="#2d2d2d" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Kuivaus PH (%):" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="PhKuivausBox" Width="80" Height="28"
                                                 Text="0" TextChanged="Ph_Changed"
                                                 Background="#3d3d3d" Foreground="White"
                                                 BorderBrush="#555" Padding="6,0"
                                                 VerticalContentAlignment="Center"/>
                                        <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#aaa"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="Ph1DimensioPanel" Background="#2d2d2d" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="PH asetteet" FontWeight="Bold" Foreground="#FFC850" Margin="0,0,0,6"/>
                                    <TextBox x:Name="Ph1DimensioNimiBox" Height="28" Margin="0,0,0,6"
                                             Background="#3d3d3d" Foreground="White" BorderBrush="#555"
                                             Padding="6,0" VerticalContentAlignment="Center"/>
                                    <Button Content="Tallenna asete" Click="TallennaPh1Dimensio_Click" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="Ph1DimensioCombo" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Lataa" Click="LataaPh1Dimensio_Click" Margin="0,0,6,0"/>
                                        <Button Content="Poista" Click="PoistaPh1Dimensio_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            

                        </StackPanel>
                    </ScrollViewer>

                    <!-- PH1 Canvas -->
                    <Border Grid.Column="1" BorderBrush="#333" BorderThickness="1,0,1,0">
                        <Canvas x:Name="Ph1Canvas" SizeChanged="PhCanvas_SizeChanged" ClipToBounds="True"/>
                    </Border>

                    <!-- PH2 Canvas -->
                    <Canvas x:Name="Ph2Canvas" Grid.Column="2" SizeChanged="PhCanvas_SizeChanged" ClipToBounds="True"/>
                </Grid>
            </TabItem>

            <!-- PROFILOINTI -->
            <TabItem Header="&#x1F4D0; Profilointi">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#1e1e1e">
                        <StackPanel Margin="10">

                            <!-- Käytössä / Ei käytössä -->
                            <Border Background="#2d2d2d" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                <CheckBox x:Name="ProfilointiCheck" Content="K&#xe4;yt&#xf6;ss&#xe4;"
                                          IsChecked="True"
                                          Checked="ProfilointiValinta_Changed"
                                          Unchecked="ProfilointiValinta_Changed"
                                          Foreground="#B39DDB" FontWeight="Bold"/>
                            </Border>

                            <!-- Referenssikappale (näkyy vain yhdistetyssä tilassa) -->
                            <Border x:Name="ProfRefPanel" Background="#2d2d2d" CornerRadius="6"
                                    Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                                <StackPanel x:Name="ProfRefStack"/>
                            </Border>

                            <Border Background="#2d2d2d" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="&#x1F4D0; Profilointi" FontWeight="Bold"
                                               Foreground="#B39DDB" Margin="0,0,0,6"/>
                                    <TextBlock Text="Ter&#xe4;offsetit:" FontSize="11"
                                               Foreground="#aaa" Margin="0,0,0,4"/>

                                    <!-- T1 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="T1" Width="20" VerticalAlignment="Center"
                                                   Foreground="#4CAF50" FontWeight="Bold"/>
                                        <Button Content="&#x2212;" Width="22" Height="22"
                                                Click="ProfT1OffsetMinus_Click" FontSize="13"/>
                                        <TextBlock x:Name="ProfT1OffsetLabel" Text="0,0" Width="40"
                                                   TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                        <Button Content="+" Width="22" Height="22"
                                                Click="ProfT1OffsetPlus_Click" FontSize="13"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center"
                                                   Margin="4,0,0,0" Foreground="#aaa" FontSize="10"/>
                                    </StackPanel>

                                    <!-- T2 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="T2" Width="20" VerticalAlignment="Center"
                                                   Foreground="#F44336" FontWeight="Bold"/>
                                        <Button Content="&#x2212;" Width="22" Height="22"
                                                Click="ProfT2OffsetMinus_Click" FontSize="13"/>
                                        <TextBlock x:Name="ProfT2OffsetLabel" Text="0,0" Width="40"
                                                   TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                        <Button Content="+" Width="22" Height="22"
                                                Click="ProfT2OffsetPlus_Click" FontSize="13"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center"
                                                   Margin="4,0,0,0" Foreground="#aaa" FontSize="10"/>
                                    </StackPanel>

                                    <!-- T3 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="T3" Width="20" VerticalAlignment="Center"
                                                   Foreground="#2196F3" FontWeight="Bold"/>
                                        <Button Content="&#x2212;" Width="22" Height="22"
                                                Click="ProfT3OffsetMinus_Click" FontSize="13"/>
                                        <TextBlock x:Name="ProfT3OffsetLabel" Text="0,0" Width="40"
                                                   TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                        <Button Content="+" Width="22" Height="22"
                                                Click="ProfT3OffsetPlus_Click" FontSize="13"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center"
                                                   Margin="4,0,0,0" Foreground="#aaa" FontSize="10"/>
                                    </StackPanel>

                                    <!-- T4 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="T4" Width="20" VerticalAlignment="Center"
                                                   Foreground="#00BCD4" FontWeight="Bold"/>
                                        <Button Content="&#x2212;" Width="22" Height="22"
                                                Click="ProfT4OffsetMinus_Click" FontSize="13"/>
                                        <TextBlock x:Name="ProfT4OffsetLabel" Text="0,0" Width="40"
                                                   TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                        <Button Content="+" Width="22" Height="22"
                                                Click="ProfT4OffsetPlus_Click" FontSize="13"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center"
                                                   Margin="4,0,0,0" Foreground="#aaa" FontSize="10"/>
                                    </StackPanel>

                                    <!-- T5 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="T5" Width="20" VerticalAlignment="Center"
                                                   Foreground="#FFEB3B" FontWeight="Bold"/>
                                        <Button Content="&#x2212;" Width="22" Height="22"
                                                Click="ProfT5OffsetMinus_Click" FontSize="13"/>
                                        <TextBlock x:Name="ProfT5OffsetLabel" Text="0,0" Width="40"
                                                   TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                        <Button Content="+" Width="22" Height="22"
                                                Click="ProfT5OffsetPlus_Click" FontSize="13"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center"
                                                   Margin="4,0,0,0" Foreground="#aaa" FontSize="10"/>
                                    </StackPanel>

                                    <!-- T6 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="T6" Width="20" VerticalAlignment="Center"
                                                   Foreground="#E0E0E0" FontWeight="Bold"/>
                                        <Button Content="&#x2212;" Width="22" Height="22"
                                                Click="ProfT6OffsetMinus_Click" FontSize="13"/>
                                        <TextBlock x:Name="ProfT6OffsetLabel" Text="0,0" Width="40"
                                                   TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                        <Button Content="+" Width="22" Height="22"
                                                Click="ProfT6OffsetPlus_Click" FontSize="13"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center"
                                                   Margin="4,0,0,0" Foreground="#aaa" FontSize="10"/>
                                    </StackPanel>

                                    <!-- T7 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="T7" Width="20" VerticalAlignment="Center"
                                                   Foreground="#9E9E9E" FontWeight="Bold"/>
                                        <Button Content="&#x2212;" Width="22" Height="22"
                                                Click="ProfT7OffsetMinus_Click" FontSize="13"/>
                                        <TextBlock x:Name="ProfT7OffsetLabel" Text="0,0" Width="40"
                                                   TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                        <Button Content="+" Width="22" Height="22"
                                                Click="ProfT7OffsetPlus_Click" FontSize="13"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center"
                                                   Margin="4,0,0,0" Foreground="#aaa" FontSize="10"/>
                                    </StackPanel>

                                    <!-- T8 -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="T8" Width="20" VerticalAlignment="Center"
                                                   Foreground="#9E9E9E" FontWeight="Bold"/>
                                        <Button Content="&#x2212;" Width="22" Height="22"
                                                Click="ProfT8OffsetMinus_Click" FontSize="13"/>
                                        <TextBlock x:Name="ProfT8OffsetLabel" Text="0,0" Width="40"
                                                   TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                        <Button Content="+" Width="22" Height="22"
                                                Click="ProfT8OffsetPlus_Click" FontSize="13"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center"
                                                   Margin="4,0,0,0" Foreground="#aaa" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Canvas x:Name="ProfilointiCanvas" Grid.Column="1"
                            SizeChanged="ProfilointiCanvas_SizeChanged"/>
                </Grid>
            </TabItem>

            <!-- JAKOSAHA -->
            <TabItem Header="&#x2699; Jakosaha">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#1e1e1e">
                        <StackPanel Margin="10">

                            <StackPanel x:Name="PaksuusPanel">

                                <Border Background="#2d2d2d" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="&#x2699; Jakosahat k&#xe4;yt&#xf6;ss&#xe4;"
                                       FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="VasenSahaCheck" Content="Vasen"
                                          Margin="0,0,12,0"
                                          Checked="SahaValinta_Changed"
                                          Unchecked="SahaValinta_Changed"/>
                                            <CheckBox x:Name="OikeaSahaCheck" Content="Oikea"
                                          Checked="SahaValinta_Changed"
                                          Unchecked="SahaValinta_Changed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ErillinenPanel" Background="#2d2d2d" CornerRadius="6"
                            Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Kappaleiden m&#xe4;&#xe4;r&#xe4;:" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox x:Name="KappaleCombo" Width="70"
                                          SelectionChanged="Kappale_Changed">
                                                <ComboBoxItem Content="2"/>
                                                <ComboBoxItem Content="3"/>
                                                <ComboBoxItem Content="4"/>
                                            </ComboBox>
                                            <TextBlock x:Name="KappaleInfo" Text="4 kpl / saha"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="#aaa" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel x:Name="HalkaisuPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                            <TextBlock Text="Halkaiseva ter&#xe4;:" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel x:Name="HalkaisuOikeaContainer" Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Oikea:" FontSize="11" Foreground="#aaa"/>
                                                    <ComboBox x:Name="HalkaisuOikeaCombo"
                                                  SelectionChanged="Halkaisu_Changed">
                                                        <ComboBoxItem Content="T4 &#x2014; p&#xe4;&#xe4;"/>
                                                        <ComboBoxItem Content="T2 &#x2014; sivu"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel x:Name="HalkaisuVasenContainer" Grid.Column="1">
                                                    <TextBlock Text="Vasen:" FontSize="11" Foreground="#aaa"/>
                                                    <ComboBox x:Name="HalkaisuVasenCombo"
                                                  SelectionChanged="Halkaisu_Changed">
