<Window x:Class="SahanOhjausGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sahan Ohjaus GUI"
        Height="900" Width="1400"
        Background="#121212"
        Foreground="White"
        FontFamily="Segoe UI">

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── YLÄPALKKI ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2A2A2A"
                BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Vasen: otsikko + status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Sahan ohjaus"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#4FC3F7"
                               VerticalAlignment="Center"/>
                    <Border Background="#252525" CornerRadius="6"
                            Padding="10,3" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Valmis"
                                   Foreground="#CFCFCF"
                                   FontSize="12"/>
                    </Border>
                </StackPanel>

                <!-- Keskellä: PLC paikoitukset kompaktina -->
                <Border Grid.Column="1" Background="#1F1F1F"
                        BorderBrush="#3A3A3A" BorderThickness="1"
                        CornerRadius="8" Padding="14,6"
                        Margin="20,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📍"
                                   FontSize="13" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>

                        <!-- Oikea saha -->
                        <TextBlock Text="O:"
                                   Foreground="#6BCB77" FontWeight="Bold"
                                   FontSize="12" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <Border Background="#252525" CornerRadius="4"
                                Padding="6,3" Margin="0,0,4,0">
                            <TextBlock x:Name="Tera2_Value" Text="T2: 0.0"
                                       Foreground="#E0E0E0" FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>
                        <Border Background="#252525" CornerRadius="4"
                                Padding="6,3" Margin="0,0,4,0"
                                BorderBrush="#FFD93D" BorderThickness="1">
                            <TextBlock x:Name="Tera4_Value" Text="T4: 0.0"
                                       Foreground="#FFD93D" FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>
                        <Border Background="#252525" CornerRadius="4"
                                Padding="6,3" Margin="0,0,20,0">
                            <TextBlock x:Name="Tera6_Value" Text="T6: 0.0"
                                       Foreground="#E0E0E0" FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>

                        <!-- Vasen saha -->
                        <TextBlock Text="V:"
                                   Foreground="#FF6B6B" FontWeight="Bold"
                                   FontSize="12" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <Border Background="#252525" CornerRadius="4"
                                Padding="6,3" Margin="0,0,4,0">
                            <TextBlock x:Name="Tera1_Value" Text="T1: 0.0"
                                       Foreground="#E0E0E0" FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>
                        <Border Background="#252525" CornerRadius="4"
                                Padding="6,3" Margin="0,0,4,0"
                                BorderBrush="#FFD93D" BorderThickness="1">
                            <TextBlock x:Name="Tera3_Value" Text="T3: 0.0"
                                       Foreground="#FFD93D" FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>
                        <Border Background="#252525" CornerRadius="4"
                                Padding="6,3">
                            <TextBlock x:Name="Tera5_Value" Text="T5: 0.0"
                                       Foreground="#E0E0E0" FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Oikea: teräasetukset-nappi -->
                <Button Grid.Column="2"
                        x:Name="AvaaTerapAsetuksetBtn"
                        Content="⚡ Teräasetukset"
                        Height="34"
                        Padding="14,0"
                        Background="#1F2A35"
                        BorderBrush="#4FC3F7"
                        BorderThickness="1"
                        Foreground="#4FC3F7"
                        FontSize="13" FontWeight="Bold"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="AvaaTerapAsetukset_Click"/>
            </Grid>
        </Border>

        <!-- ── PÄÄSISÄLTÖ ────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Vasen paneeli: asetukset + paksuudet -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          Background="#161616">
                <StackPanel Margin="16">

                    <!-- SAHAT KÄYTÖSSÄ -->
                    <Border Background="#1F1F1F" BorderBrush="#3A3A3A"
                            BorderThickness="1" CornerRadius="8"
                            Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="⚙ Sahat käytössä"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#4FC3F7" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox x:Name="VasenSahaCheck"
                                          Content="Vasen"
                                          IsChecked="True"
                                          Margin="0,0,16,0"
                                          Checked="SahaValinta_Changed"
                                          Unchecked="SahaValinta_Changed"
                                          Foreground="#FF6B6B" FontSize="13"/>
                                <CheckBox x:Name="OikeaSahaCheck"
                                          Content="Oikea"
                                          IsChecked="True"
                                          Checked="SahaValinta_Changed"
                                          Unchecked="SahaValinta_Changed"
                                          Foreground="#4FC3F7" FontSize="13"/>
                            </StackPanel>

                            <TextBlock Text="Kappaleiden määrä:"
                                       Margin="0,0,0,4" Foreground="#FFD93D"
                                       FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ComboBox x:Name="KappaleCombo"
                                          Width="80" Height="30"
                                          SelectionChanged="Kappale_Changed">
                                    <ComboBoxItem>2</ComboBoxItem>
                                    <ComboBoxItem>3</ComboBoxItem>
                                    <ComboBoxItem IsSelected="True">4</ComboBoxItem>
                                </ComboBox>
                                <TextBlock x:Name="KappaleInfo"
                                           Text="4 kpl / saha"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#E0E0E0"
                                           FontSize="12"/>
                            </StackPanel>

                            <!-- HALKAISUTERÄ -->
                            <StackPanel x:Name="HalkaisuPanel" Visibility="Collapsed">
                                <TextBlock Text="Halkaiseva terä:"
                                           Margin="0,0,0,4" Foreground="#FFD93D"
                                           FontSize="12"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Oikea:" Foreground="#4FC3F7"
                                                   FontSize="11" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="HalkaisuOikeaCombo"
                                                  Height="28" FontSize="11"
                                                  SelectionChanged="Halkaisu_Changed">
                                            <ComboBoxItem IsSelected="True">T4 — pää</ComboBoxItem>
                                            <ComboBoxItem>T2 — sisä</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Vasen:" Foreground="#FF6B6B"
                                                   FontSize="11" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="HalkaisuVasenCombo"
                                                  Height="28" FontSize="11"
                                                  SelectionChanged="Halkaisu_Changed">
                                            <ComboBoxItem IsSelected="True">T3 — pää</ComboBoxItem>
                                            <ComboBoxItem>T1 — sisä</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="Kuivaus (%):"
                                       Margin="0,0,0,4" Foreground="#FFD93D"
                                       FontSize="12"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="KuivausTextBox"
                                         Width="80" Height="30"
                                         Padding="6"
                                         TextChanged="Kuivaus_Changed"/>
                                <TextBlock x:Name="KuivausValue"
                                           Text="0 %"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="#E0E0E0"
                                           FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PAKSUUDET -->
                    <Border Background="#1F1F1F" BorderBrush="#3A3A3A"
                            BorderThickness="1" CornerRadius="8"
                            Padding="14">
                        <StackPanel x:Name="PaksuusPanel">
                            <TextBlock Text="📏 Paksuus (mm)"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#4FC3F7" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Oikea: iso sahanäkymä -->
            <Border Grid.Column="1" Background="#1F1F1F"
                    BorderBrush="#3A3A3A" BorderThickness="1"
                    CornerRadius="10" Margin="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Sahanäkymä"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#4FC3F7" Margin="0,0,0,8"/>
                    <Canvas Grid.Row="1"
                            x:Name="YhteisCanvas"
                            Background="#0D0D0D"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>