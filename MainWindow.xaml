<Window x:Class="SahanOhjausGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sahan ohjaus" Height="600" Width="1400"
        Background="#1a1a1a">
    <Window.Resources>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Background="#2d2d2d" BorderBrush="#555"
                                          Foreground="White"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Padding="6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        VerticalAlignment="Center" Margin="4,0"/>
                                    <TextBlock Grid.Column="1" Text="▾"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="White"/>
                                </Grid>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True">
                                <Border Background="#2d2d2d" BorderBrush="#555"
                                        BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#4fc3f7"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3d3d3d"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3d3d3d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Yläpalkki ── -->
        <Grid Grid.Row="0" Background="#111">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="Sahan ohjaus" FontSize="14" FontWeight="Bold"
                           Foreground="#4fc3f7" Margin="0,0,16,0"/>
                <TextBlock x:Name="StatusTextBlock" Text="Valmis" FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="O:" Foreground="#aaa" Margin="0,0,4,0"/>
                <TextBlock x:Name="Tera2_Value" Text="T2: -" Margin="0,0,8,0"/>
                <Border x:Name="Tera4_Border" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,8,0">
                    <TextBlock x:Name="Tera4_Value" Text="T4: -"/>
                </Border>
                <TextBlock x:Name="Tera6_Value" Text="T6: -" Margin="0,0,16,0"/>
                <TextBlock Text="V:" Foreground="#aaa" Margin="0,0,4,0"/>
                <TextBlock x:Name="Tera1_Value" Text="T1: -" Margin="0,0,8,0"/>
                <Border x:Name="Tera3_Border" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,8,0">
                    <TextBlock x:Name="Tera3_Value" Text="T3: -"/>
                </Border>
                <TextBlock x:Name="Tera5_Value" Text="T5: -"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="10,0">
                <Button x:Name="LahetaBtn" Content="⚡ Lähetä logiikkaan"
                        Click="Laheta_Click" Margin="0,0,8,0"
                        Background="#1b5e20" BorderBrush="#388e3c"/>
                <Button Content="⚡ Teräasetukset" Click="AvaaTerapAsetukset_Click"
                        Margin="0,0,8,0"/>
                <Button Content="🔒 Terien rajat" Click="AvaaRajatAsetukset_Click"/>
            </StackPanel>
        </Grid>

        <!-- ── Sisältö ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Vasen paneeli ── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Background="#1e1e1e">
                <StackPanel x:Name="PaksuusPanel" Margin="10">

                    <!-- 1: Sahat käytössä -->
                    <Border Background="#2d2d2d" CornerRadius="6"
                            Padding="8,6" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="⚙ Sahat käytössä" FontWeight="Bold"
                                       Foreground="#4fc3f7" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="VasenSahaCheck" Content="Vasen"
                                          Margin="0,0,12,0"
                                          Checked="SahaValinta_Changed"
                                          Unchecked="SahaValinta_Changed"/>
                                <CheckBox x:Name="OikeaSahaCheck" Content="Oikea"
                                          Checked="SahaValinta_Changed"
                                          Unchecked="SahaValinta_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2: Kappaleiden määrä — erillinen saha -->
                    <Border x:Name="ErillinenPanel" Background="#2d2d2d" CornerRadius="6"
                            Padding="8,6" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Kappaleiden määrä:" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="KappaleCombo" Width="70"
                                          SelectionChanged="Kappale_Changed">
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4" IsSelected="True"/>
                                </ComboBox>
                                <TextBlock x:Name="KappaleInfo" Text="4 kpl / saha"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="#aaa" FontSize="11"/>
                            </StackPanel>

                            <!-- Halkaisuterä — näkyy vain 2kpl:lla -->
                            <StackPanel x:Name="HalkaisuPanel" Margin="0,6,0,0"
                                        Visibility="Collapsed">
                                <TextBlock Text="Halkaiseva terä:" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Oikea:" FontSize="11"
                                                   Foreground="#aaa"/>
                                        <ComboBox x:Name="HalkaisuOikeaCombo"
                                                  SelectionChanged="Halkaisu_Changed">
                                            <ComboBoxItem Content="T4 — pää" IsSelected="True"/>
                                            <ComboBoxItem Content="T2 — sivu"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Vasen:" FontSize="11"
                                                   Foreground="#aaa"/>
                                        <ComboBox x:Name="HalkaisuVasenCombo"
                                                  SelectionChanged="Halkaisu_Changed">
                                            <ComboBoxItem Content="T3 — pää" IsSelected="True"/>
                                            <ComboBoxItem Content="T1 — sivu"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3: Kappaleiden määrä — yhdistetty -->
                    <Border x:Name="YhdistettyPanel" Background="#2d2d2d" CornerRadius="6"
                            Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Yhdistetty sahaus:" FontWeight="Bold"
                                       Foreground="#ffd93d" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="YhdistettyCombo" Width="70"
                                          SelectionChanged="YhdistettyKappale_Changed">
                                    <ComboBoxItem Content="3" IsSelected="True"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="7"/>
                                </ComboBox>
                                <TextBlock x:Name="YhdistettyInfo" Text="3 kpl"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="#aaa" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 4: Kuivaus -->
                    <Border Background="#2d2d2d" CornerRadius="6"
                            Padding="8,6" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Kuivaus (%):" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="KuivausTextBox" Width="80" Height="28"
                                         Text="0" TextChanged="Kuivaus_Changed"
                                         Background="#3d3d3d" Foreground="White"
                                         BorderBrush="#555" Padding="6,0"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock x:Name="KuivausValue" Text="0 %"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="#aaa"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Paksuudet lisätään koodista tähän -->

                </StackPanel>
            </ScrollViewer>

            <!-- ── Canvas ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Canvas x:Name="YhteisCanvas"
                        SizeChanged="Canvas_SizeChanged"/>
            </Grid>
        </Grid>
    </Grid>
</Window>