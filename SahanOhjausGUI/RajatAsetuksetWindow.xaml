<Window x:Class="SahanOhjausGUI.RajatAsetuksetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terien rajat ja leposijainnit"
        Width="680" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1a1a"
        Foreground="White">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#323232"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#646464"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Otsikko -->
        <TextBlock Grid.Row="0" Text="⚙ Terien rajat ja leposijainnit"
                   FontSize="15" FontWeight="Bold"
                   Foreground="#4FC3F7" Margin="0,0,0,12"/>

        <!-- Terien rivit -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TeratPanel"/>
        </ScrollViewer>

        <!-- Napit -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Peruuta" Width="90" Height="32" Margin="0,0,8,0"
                    Background="#424242" Foreground="White" BorderThickness="0"
                    Click="Peruuta_Click"/>
            <Button Content="✓  Tallenna" Width="110" Height="32"
                    Background="#2E7D32" Foreground="White" BorderThickness="0"
                    FontWeight="Bold" Click="Tallenna_Click"/>
        </StackPanel>
    </Grid>
</Window>